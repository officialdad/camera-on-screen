<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:CameraOnScreen.App.Avalonia"
        xmlns:core="using:CameraOnScreen.Core"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="720"
        x:Class="CameraOnScreen.App.Avalonia.MainWindow"
        Width="440" Height="720"
        Title="Camera On Screen">

    <!-- Phase 1: control-panel parity with the WinUI MainWindow.xaml, bound to the reused
         Core MainViewModel. Overlay / hooks / hotkeys / frame pump are Phase 2+ (native, per-OS). -->

    <Window.Resources>
        <conv:StatusLineConverter x:Key="StatusLine" />
        <conv:AllTrueConverter x:Key="AllTrue" />
        <conv:QualityEnabledConverter x:Key="QualityEnabled" />
        <!-- ponytail: theme-neutral card + caution brushes instead of guessing Fluent resource keys;
             swap for DynamicResource theme brushes if exact WinUI card styling is wanted later. -->
        <SolidColorBrush x:Key="CardBg" Color="#0A808080" />
        <SolidColorBrush x:Key="CardStroke" Color="#33808080" />
        <SolidColorBrush x:Key="Caution" Color="#E0A000" />
        <SolidColorBrush x:Key="Danger" Color="#E06C75" />
    </Window.Resources>

    <Grid RowDefinitions="*,Auto">
        <!-- Controls scroll; the license-required footer (row 1) stays pinned outside. -->
        <ScrollViewer Grid.Row="0" Padding="16">
            <StackPanel Spacing="16">

                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardStroke}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <TextBlock TextWrapping="Wrap"
                               Text="Scroll over the overlay to resize it · drag the + handle to move it." />
                </Border>

                <!-- CAMERA -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Camera" FontWeight="SemiBold" />
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardStroke}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Camera" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Cameras}"
                                          SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                                          DropDownOpened="CameraCombo_DropDownOpened">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Start" Command="{Binding StartCommand}" />
                                <Button Content="Stop" Command="{Binding StopCommand}" />
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource StatusLine}">
                                            <Binding Path="IsRunning" />
                                            <Binding Path="Fps" />
                                            <Binding Path="FrameWidth" />
                                            <Binding Path="FrameHeight" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding CameraError}" TextWrapping="Wrap"
                                       Foreground="{StaticResource Danger}"
                                       IsVisible="{Binding CameraError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ToggleSwitch Content="Mirror (selfie view)" IsChecked="{Binding Mirror, Mode=TwoWay}" />
                            <ToggleSwitch Content="Lock exposure (steady FPS)"
                                          IsEnabled="{Binding ExposureSupported}"
                                          IsChecked="{Binding ExposureLock, Mode=TwoWay}" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="Exposure" />
                                <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding ExposureValue, Mode=TwoWay}">
                                    <Slider.IsEnabled>
                                        <MultiBinding Converter="{StaticResource AllTrue}">
                                            <Binding Path="ExposureSupported" />
                                            <Binding Path="ExposureLock" />
                                        </MultiBinding>
                                    </Slider.IsEnabled>
                                </Slider>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- AI EFFECTS -->
                <StackPanel Spacing="8">
                    <TextBlock Text="AI Effects" FontWeight="SemiBold" />
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardStroke}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="12">
                            <ToggleSwitch Content="AI Green Screen" IsEnabled="{Binding EffectsAvailable}"
                                          IsChecked="{Binding GreenScreenEnabled, Mode=TwoWay}" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="Green-screen Expand" />
                                <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        IsEnabled="{Binding GreenScreenEnabled}"
                                        Value="{Binding GreenScreenExpand, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Green-screen Feather" />
                                <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        IsEnabled="{Binding GreenScreenEnabled}"
                                        Value="{Binding GreenScreenFeather, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Green-screen Engine" />
                                <ComboBox HorizontalAlignment="Stretch" IsEnabled="{Binding EffectsAvailable}"
                                          SelectedIndex="{Binding GreenScreenBackendIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Auto" />
                                    <ComboBoxItem Content="NVIDIA Maxine (GPU)"
                                                  IsEnabled="{Binding GreenScreenMaxineAvailable}" />
                                    <ComboBoxItem Content="ONNX (CPU)"
                                                  IsEnabled="{Binding GreenScreenOnnxAvailable}" />
                                </ComboBox>
                            </StackPanel>
                            <ToggleSwitch Content="Eye Contact" IsEnabled="{Binding EyeContactAvailable}"
                                          IsChecked="{Binding EyeContactEnabled, Mode=TwoWay}" />
                            <TextBlock Text="{Binding EyeContactDetail}" IsVisible="{Binding !EyeContactAvailable}"
                                       TextWrapping="Wrap" Foreground="{StaticResource Caution}" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="AI Sharpness" />
                                <ComboBox HorizontalAlignment="Stretch" IsEnabled="{Binding SuperResAvailable}"
                                          SelectedIndex="{Binding SuperResModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem>Off</ComboBoxItem>
                                    <ComboBoxItem>Denoise</ComboBoxItem>
                                    <ComboBoxItem>Deblur</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Quality" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          SelectedIndex="{Binding SuperResQualityIndex, Mode=TwoWay}">
                                    <ComboBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource QualityEnabled}">
                                            <Binding Path="SuperResAvailable" />
                                            <Binding Path="SuperResModeIndex" />
                                        </MultiBinding>
                                    </ComboBox.IsEnabled>
                                    <ComboBoxItem>Low</ComboBoxItem>
                                    <ComboBoxItem>Medium</ComboBoxItem>
                                    <ComboBoxItem>High</ComboBoxItem>
                                    <ComboBoxItem>Ultra</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <ToggleSwitch Content="Smooth 60 fps (AI)" IsEnabled="{Binding FrameInterpAvailable}"
                                          IsChecked="{Binding FrameInterpEnabled, Mode=TwoWay}" />
                            <TextBlock Text="{Binding CapabilityDetail}" IsVisible="{Binding !EffectsAvailable}"
                                       TextWrapping="Wrap" Foreground="{StaticResource Caution}" />
                            <!-- #59: native effect errors (green screen / eye contact / sharpness /
                                 FRUC), polled every 250 ms. Bound raw and unlatched — cos_get_status
                                 supplies the effect label and the capture backends clear the string
                                 themselves, so there is nothing to format or reset here. Lives in
                                 this card, not next to CameraError, because CosStatus.error only
                                 ever carries effect failures. -->
                            <TextBlock Text="{Binding StatusError}" TextWrapping="Wrap"
                                       Foreground="{StaticResource Danger}"
                                       IsVisible="{Binding StatusError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Required NVIDIA Maxine attribution (SDK License Supplement §3.1) — always visible. -->
        <TextBlock Grid.Row="1" Margin="16,8,16,12"
                   Text="{x:Static core:AppInfo.MaxineAttribution}"
                   FontSize="12" Opacity="0.7" />
    </Grid>
</Window>
